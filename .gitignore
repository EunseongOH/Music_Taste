# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# apps in toss (Vite 빌드 산출물)
/toss/app/dist/
/toss/*.ait

# 내보내기 회귀 검증의 임시 결과물. 기준선(toss/baseline/refs)은 커밋한다 —
# taste/page.tsx 리팩터 이후에는 다시 뜰 수 없기 때문.
/toss/baseline/refs-verify/

# temp files
temp_artists.json
temp_code.ts
temp_search_results.json
/scratch/

