# Update these with your Supabase details from your project settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Spotify API Keys
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# 토스 미니앱 — 익명 식별키에서 Supabase 계정을 유도할 때 쓰는 서버 전용 비밀값.
# 이 값이 없으면 /api/toss/session 은 503 을 돌려준다(기본값: 꺼짐).
# ⚠️ 익명키 검증(mTLS)이 구현되기 전에는 운영 환경에 넣지 말 것 — Phase 9.2 출시 게이트.
TOSS_USER_PEPPER=

# 토스 서버 식별키 검증 모드. 설정하지 않으면 enforce(기본, fail-closed).
#   enforce — 검증을 통과한 키만 발급. 운영은 이 값이어야 한다.
#   log     — 결과만 기록하고 발급은 허용. 인증서 설정 직후 전환 확인용.
#   off     — 검증하지 않음. 샌드박스는 mock 키를 주므로 거기서만 쓴다.
TOSS_ANON_KEY_VERIFY=

# mTLS 클라이언트 인증서. 발급 형태에 따라 둘 중 하나만 채우면 된다.
# 줄바꿈이 많은 PEM 이 환경변수에서 깨지지 않도록 base64 로 넣는다.
#   (1) PKCS#12 한 덩어리(.p12/.pfx)
TOSS_MTLS_PFX_BASE64=
#   (2) PEM 쌍(.crt/.pem + .key)
TOSS_MTLS_CERT_BASE64=
TOSS_MTLS_KEY_BASE64=
# 개인키에 암호가 걸려 있을 때만
TOSS_MTLS_PASSPHRASE=
