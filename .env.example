# Update these with your Supabase details from your project settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Spotify API Keys
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# 토스 미니앱 — 익명 식별키에서 Supabase 계정을 유도할 때 쓰는 서버 전용 비밀값.
# 이 값이 없으면 /api/toss/session 은 503 을 돌려준다(기본값: 꺼짐).
# ⚠️ 익명키 검증(mTLS)이 구현되기 전에는 운영 환경에 넣지 말 것 — Phase 9.2 출시 게이트.
TOSS_USER_PEPPER=

# true 로 두면 토스 검증 API 를 통과한 익명키만 세션을 발급받는다.
# verifyAnonKey() 구현 후 운영에서 반드시 켜야 한다.
TOSS_REQUIRE_ANON_KEY_VERIFY=
